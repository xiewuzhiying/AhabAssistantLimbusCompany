#!/usr/bin/env bash
set -euo pipefail
aalc_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$aalc_root"
if [ -e /etc/NIXOS ] && command -v nix >/dev/null 2>&1; then
    exec nix develop --command python scripts/linux/cli.py "$@"
elif command -v uv >/dev/null 2>&1; then
    exec uv run --frozen python scripts/linux/cli.py "$@"
elif command -v nix >/dev/null 2>&1; then
    exec nix develop --command python scripts/linux/cli.py "$@"
else
    echo "Install uv, or activate the project Python environment and run python scripts/linux/cli.py" >&2
    exit 1
fi
